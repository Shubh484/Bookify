generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Room {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  location  String    // e.g., "Floor 3, Wing A"
  capacity  Int
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Booking {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  room      Room          @relation(fields: [roomId], references: [id])
  roomId    String        @db.ObjectId
  date      DateTime
  startTime String        // "09:00", "09:30", etc.
  endTime   String        // "10:00", "10:30", etc.
  bookedBy  String        // Name
  email     String
  title     String
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())

  // Waitlist entries for this booking's slots
  waitlistEntries WaitlistEntry[]

  // Each individual slot occupied by this booking gets a SlotLock row
  slotLocks SlotLock[]

  @@index([email])
  @@index([roomId, date])
}

// THIS IS THE KEY TABLE FOR DOUBLE-BOOKING PREVENTION
// One row per 30-minute slot held by a booking.
// The UNIQUE constraint makes it physically impossible to double-book.
model SlotLock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String   @db.ObjectId
  date      DateTime
  slotStart String   // "09:00", "09:30", etc.
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String   @db.ObjectId

  @@unique([roomId, date, slotStart], name: "room_slot_unique")
}

// Extended Req 4.2: Waitlist
model WaitlistEntry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  roomId    String   @db.ObjectId
  date      DateTime
  slotStart String   // The specific slot they want
  userName  String
  email     String
  booking   Booking? @relation(fields: [bookingId], references: [id])
  bookingId String?  @db.ObjectId  // Linked when auto-promoted
  position  Int      // Queue position
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime @default(now())

  @@index([roomId, date, slotStart, status])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED_REFUNDABLE
  CANCELLED_NON_REFUNDABLE
}

enum WaitlistStatus {
  WAITING
  PROMOTED
  EXPIRED
}
